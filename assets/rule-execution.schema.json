{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selected strict rule execution contract",
  "type": "object",
  "required": ["required_capabilities", "workspace_root", "rule_execution"],
  "properties": {
    "required_capabilities": {"type": "array", "contains": {"const": "rule-execution/v1"}},
    "workspace_root": {"type": "string"},
    "rule_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "rules"],
      "properties": {
        "schema": {"const": 1},
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_id", "experience_ref", "severity", "applies_at", "trigger_id", "checker_id", "checker_version", "observation_source_id"],
            "properties": {
              "rule_id": {"type": "string", "minLength": 1},
              "experience_ref": {"type": ["null", "object"]},
              "severity": {"enum": ["advisory", "load-bearing"]},
              "applies_at": {"type": "array", "minItems": 1, "items": {"enum": ["release", "resume", "handoff", "completion"]}},
              "trigger_id": {"type": "string", "minLength": 1},
              "checker_id": {"type": "string", "minLength": 1},
              "checker_version": {"type": "string", "minLength": 1},
              "observation_source_id": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
