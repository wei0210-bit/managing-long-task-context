      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "base_dir": {
          "type": "string",
          "format": "absolute-path",
          "maxLength": 2048
        },
        "workspace_root": {
          "type": "string",
          "format": "absolute-path",
          "maxLength": 2048
        },
        "package_root": {
          "type": "string",
          "format": "absolute-path",
          "maxLength": 2048
        },
        "handoff_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
